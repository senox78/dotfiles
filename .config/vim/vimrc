" This Vim is built with +clipboard_provider instead of +clipboard. Expose
" the +/* registers through wl-clipboard on local Wayland sessions.
if has('clipboard_provider') && executable('wl-copy') && executable('wl-paste')
  function! s:WlClipboardAvailable() abort
    return !empty($WAYLAND_DISPLAY) && empty($SSH_CONNECTION) && empty($SSH_TTY)
  endfunction

  function! s:WlClipboardCopy(register, regtype, lines) abort
    let command = a:register ==# '*' ? 'wl-copy --primary' : 'wl-copy'
    call system(command, a:lines)
  endfunction

  function! s:WlClipboardPaste(register) abort
    let command = 'wl-paste --no-newline --type text/plain;charset=utf-8'
    if a:register ==# '*'
      let command .= ' --primary'
    endif
    return ['', systemlist(command)]
  endfunction

  let v:clipproviders['wl_clipboard'] = {
        \ 'available': function('s:WlClipboardAvailable'),
        \ 'copy': {
        \   '+': function('s:WlClipboardCopy'),
        \   '*': function('s:WlClipboardCopy'),
        \ },
        \ 'paste': {
        \   '+': function('s:WlClipboardPaste'),
        \   '*': function('s:WlClipboardPaste'),
        \ },
        \ }
  set clipmethod^=wl_clipboard
endif

