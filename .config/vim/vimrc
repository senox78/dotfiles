function! s:open_file_with_icon(line)
  let filepath = matchstr(a:line, '\S\+\s\+\zs.*')
  execute 'edit' fnameescape(filepath)
endfunction

function! FilesWithIcons()
  let files = systemlist('fd --type f --hidden')
  let files = map(files, 'WebDevIconsGetFileTypeSymbol(v:val) . " " . v:val')
  call fzf#run(fzf#wrap({
        \ 'source': files,
        \ 'sink': function('s:open_file_with_icon'),
        \ }))
endfunction

command! FilesIcons call FilesWithIcons()

function! CopyDiagnostic() abort
  if exists(':ALEInfo') != 2
    echohl WarningMsg
    echo 'ALE is not installed. Run :PlugInstall.'
    echohl None
    return
  endif

  let diagnostics = filter(
        \ copy(ale#engine#GetLoclist(bufnr(''))),
        \ {_, diagnostic -> get(diagnostic, 'lnum', 0) == line('.')}
        \ )

  if empty(diagnostics)
    echohl WarningMsg
    echo 'No diagnostics found on current line.'
    echohl None
    return
  endif

  let diagnostic = diagnostics[0]
  let severity = get({'E': 'Error', 'W': 'Warn', 'I': 'Info'},
        \ get(diagnostic, 'type', ''), 'Unknown')
  let start_lnum = get(diagnostic, 'lnum', line('.'))
  let end_lnum = max([start_lnum, get(diagnostic, 'end_lnum', start_lnum)])
  let start_col = get(diagnostic, 'col', 1)
  let end_col = max([start_col, get(diagnostic, 'end_col', start_col)])
  let context_start = max([1, start_lnum - 3])
  let context_end = min([line('$'), end_lnum + 3])
  let target_text = join(getline(context_start, context_end), "\n")
  let source = get(diagnostic, 'linter_name', 'ALE')
  let code = get(diagnostic, 'code', 'N/A')
  let code_text = empty(code) ? 'N/A' : (type(code) == v:t_string ? code : string(code))

  let clipboard_text = printf(
        \ "%s: %s [%s] (Source: %s) at %d:%d-%d:%d\n%s\n",
        \ severity,
        \ get(diagnostic, 'text', ''),
        \ code_text,
        \ empty(source) ? 'ALE' : source,
        \ start_lnum,
        \ start_col,
        \ end_lnum,
        \ end_col,
        \ target_text
        \ )

  call setreg('+', clipboard_text)
  echo 'Diagnostic copied to clipboard!'
endfunction

